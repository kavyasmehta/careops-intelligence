# Copy this file to .env and adjust as needed. Never commit the real .env file.

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGO_URI=mongodb://localhost:27018
MONGO_DB=careops

NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=careops-dev-password

# CSV of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Reproducible synthetic data generation
SEED_RANDOM_SEED=42

# --- AI case-summary feature ---
# Off by default: the app always works with a deterministic template summary.
# Set to true (and provide LLM_API_KEY) to opt into real LLM-generated summaries.
# Also requires `pip install anthropic` in the backend venv — not a default
# dependency, since the template path never needs it.
ENABLE_LLM_SUMMARY=false
LLM_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
